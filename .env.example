# Copy to .env and set your own cryptographically random credential before starting.
# Required: 32-256 ASCII characters using Bearer token syntax; no Bearer prefix.
# A suitable value can be generated locally with: openssl rand -hex 32
# This empty placeholder intentionally fails startup until configured.
SECRET_TOKEN=

# Container-internal HTTP port. Update Docker's target port when changing it.
HTTP_PORT=8080

# Public IP checks are enabled by default. Set false only for controlled diagnostics.
# Allowed platform hosts may then resolve to loopback, private, or reserved addresses.
# Restart the process or recreate the container after changing this value.
# Set true and apply the change the same way to restore checks.
VALIDATE_PUBLIC_IP=true
